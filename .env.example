# ── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aspire_studio
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aspire_studio_shadow

# ── Auth (Clerk) ───────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ── CORS ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── AI providers (a provider is enabled when its key is set) ─
# Groq is the launch provider. OpenAI and HuggingFace are optional.
GROQ_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# ── Usage limits ───────────────────────────────────────────
# Monthly token allowance for orgs without a subscription
FREE_MONTHLY_TOKENS=200000

# ── Queue (Bull + Redis) — `docker compose -f docker-compose.redis.yml up -d` ─
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Artifact storage: local | s3 ───────────────────────────
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./storage
# Origin browsers use to reach this API (signed download links are built from it)
BACKEND_PUBLIC_URL=http://localhost:3002
# Secret for signing download links; defaults to CLERK_SECRET_KEY. Required in production.
STORAGE_SIGNING_SECRET=

# ── LangChain agents (optional; /api/v1/workflows/agents) ──
LLM_PROVIDER=ollama
LLM_MODEL=mistral
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
OLLAMA_BASE_URL=http://localhost:11434
HUGGINGFACE_API_KEY=
